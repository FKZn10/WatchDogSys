<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.userProducer.mapper.SysShortMessageLogMapper">

    <sql id="listFilter">
        <if test="params.smlUname!=null">
            and mn.Sml_Uname like concat('%',#{params.smlUname},'%')
        </if>
        <if test="params.smlMobilePhone!=null">
            and mn.Sml_Mobile_Phone like concat('%',#{params.smlMobilePhone},'%')
        </if>
        <if test="params.unSuccess==true">
            and (mn.Sml_Send_Result != 'ok' or mn.Sml_Send_Result is null)
        </if>
    </sql>

    <select id="getSysShortMessageLogList"
            resultType="com.jpmsoft.common.model.requestAndResponse.Sms.SysShortMessageLogModel">
        select
        mn.*
        from  SYS_Short_Message_Log mn
        where 1=1
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Sml_Create_Time desc
            </otherwise>
        </choose>
        limit #{params.start},#{params.size}
    </select>

    <select id="getSysShortMessageLogListCount" resultType="java.lang.Integer">
        select
        count(1)
        from  SYS_Short_Message_Log mn
        where 1=1
        <include refid="listFilter"/>
    </select>
</mapper>