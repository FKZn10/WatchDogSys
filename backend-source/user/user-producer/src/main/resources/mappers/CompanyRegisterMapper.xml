<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.userProducer.mapper.CompanyRegisterMapper">

    <select id="getCompanyRegisterList"
            resultType="com.jpmsoft.common.model.requestAndResponse.Project.CompanyRegisterModel">
        select * from company_register
        <where>
            1=1
            <if test="params.creditCode != null and params.creditCode !=''">
                and credit_code = #{params.creditCode}
            </if>
            <if test="params.name != null and params.name !=''">
                and name like concat('%',#{params.name},'%')
            </if>
            <if test="params.status != null and params.status !=''">
                and status = #{params.status}
            </if>
            <if test="params.createUid != null and params.createUid !=''">
                and Create_Uid = #{params.createUid}
            </if>
            <if test="params.cId != null and params.cId !=''">
                and C_Id = #{params.cId}
            </if>
        </where>
    </select>

    <select id="getCompanyRegister"
            resultType="com.jpmsoft.common.model.requestAndResponse.Project.CompanyRegisterModel">
        select * from company_register where id = #{id}
    </select>
</mapper>