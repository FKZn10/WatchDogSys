<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.userProducer.mapper.SysPowerMapper">

    <select id="getPowerCheckByRoleAndCode" resultType="com.jpmsoft.userProducer.pojo.vo.PowerCheckVO">
        select
            mn.Power_Name as powerName,
            mn.Power_Code as powerCode,
            (case when (select count(*) from SYS_Role_Power rp1 where rp1.Role_Id=#{roleId} and rp1.Power_ID=mn.Power_ID)>0 then true else false end)
            as checkBox
        from Sys_Power mn
        left join Sys_Power parent on parent.Power_ID=mn.Power_ParentID
        where mn.Power_Type='1' and mn.Power_Status='1'
        <if test="code!=null">
            and parent.Power_Code=#{code}
        </if>
        order by mn.Power_Sort ASC
    </select>
    
    <insert id="BatchSavePower"   >
        insert into
        SYS_Power(Power_ID,Power_Type,Power_Name,Power_Code,Power_ParentID,Power_Path,Power_URL,Power_Controller,Power_Action,Power_CreateTime,Power_CreateU_ID,Power_CreateU_Name,Power_Solution,Power_Status,Power_Sort,Power_Icon,Power_Home_Page,Power_Component,Power_View,Power_Redirect,Power_Route,Power_Hidden,Power_KeepAlive,Power_AlwaysShow,Power_InternalOrExternal,Power_Authorization_Code,Power_Authorization_Policy,Power_Highlight,Power_Admin,Te_Id,Power_Pattern,Power_Parameter)
        values
        <foreach collection="list" item="item" separator=",">(
            #{item.powerId},
            #{item.powerType},
            #{item.powerName},
            #{item.powerCode},
            #{item.powerParentid},
            #{item.powerPath},
            #{item.powerUrl},
            #{item.powerController},
            #{item.powerAction},
            #{item.powerCreatetime},
            #{item.powerCreateuId},
            #{item.powerCreateuName},
            #{item.powerSolution},
            #{item.powerStatus},
            #{item.powerSort},
            #{item.powerIcon},
            #{item.powerHomePage},
            #{item.powerComponent},
            #{item.powerView},
            #{item.powerRedirect},
            #{item.powerRoute},
            #{item.powerHidden},
            #{item.powerKeepAlive},
            #{item.powerAlwaysShow},
            #{item.powerInternalOrExternal},
            #{item.powerAuthorizationCode},
            #{item.powerAuthorizationPolicy},
            #{item.powerHighlight},
            #{item.powerAdmin},
            #{item.teId},
            #{item.powerPattern},
            #{item.powerParameter}
            )
        </foreach>
    </insert>
</mapper>