<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.userProducer.mapper.SysSplitTableMapper">

    <insert id="copyTable" databaseId="mysql">
        create table ${tableCode}_${stCode} as select * from  ${tableCode} where 1=0
    </insert>

    <insert id="copyTable" databaseId="dm">
        create table ${tableCode}_${stCode} as select * from  ${tableCode} where 1=0
    </insert>

    <insert id="copyTable" databaseId="postgre">
        CREATE TABLE ${tableCode}_${stCode} (LIKE  ${tableCode} INCLUDING ALL)
    </insert>
</mapper>