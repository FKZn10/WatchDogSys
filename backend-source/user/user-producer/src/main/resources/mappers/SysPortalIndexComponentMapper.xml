<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.userProducer.mapper.SysPortalIndexComponentMapper">

    <select id="getSysPortalIndexComponentByMainIdsList"
            resultType="com.jpmsoft.userProducer.pojo.dto.SysPortalIndexComponentDto">
        select
            mn.*,
            sr.Role_Name as roleName
        from sys_portal_index_component mn
        left join SYS_Role sr on sr.Role_ID=mn.Role_Id
        where 1=1
        <if test="mainIds != null and mainIds.size() > 0">
            and mn.Index_Config_Id in
            <foreach collection="mainIds" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>

    <select id="getSysPortalIndexComponentByRoleIds"
            resultType="com.jpmsoft.userProducer.pojo.entity.SysPortalIndexComponent">
        select
            mn.*
        from sys_portal_index_component mn
        where 1=1
        <if test="roleIds != null and roleIds.size() > 0">
            and mn.Role_Id in
            <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
                #{roleId}
            </foreach>
        </if>
    </select>
</mapper>