<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.userProducer.mapper.SysSequenceSetDtlMapper">

    <select id="getSysSequenceSetDtlList"
            resultType="com.jpmsoft.userProducer.pojo.dto.SysSequenceSetDtlDto">
        select
        mn.*
        from SYS_Sequence_Set_Dtl mn
        <where>
            1=1
            <if test="params.sId!=null">
                and mn.S_Id = #{params.sId}
            </if>
        </where>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Sd_Rule_Order DESC
            </otherwise>
        </choose>
        limit #{params.start},#{params.size}
    </select>

    <select id="getSysSequenceSetDtlListCount"
            resultType="java.lang.Integer">
        select
        count(1)
        from  SYS_Sequence_Set_Dtl mn
        <where>
            1=1
            <if test="params.sId!=null">
                and mn.S_Id = #{params.sId}
            </if>
        </where>
    </select>
</mapper>