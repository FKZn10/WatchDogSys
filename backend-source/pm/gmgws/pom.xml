    <groupId>com.jpmsoft.gmgws</groupId>
    <artifactId>gmgws</artifactId>
    <version>1.0.0.0.0</version>
    <name>gmgws</name>
    <description>Demo project for Spring Cloud</description>
    <packaging>${project.packaging}</packaging>

    <profiles>
        <!-- 默认打包配置 war包 -->
        <profile>
            <id>defaultWar</id>
            <activation>
                <!-- 默认环境 -->
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <project.packaging>war</project.packaging>
                <activatedEnv>dev</activatedEnv>
                <swgEnable>true</swgEnable>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-starter-tomcat</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-war-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- 默认打包配置 jar包 -->
        <profile>
            <id>defaultJar</id>
            <properties>
                <project.packaging>jar</project.packaging>
                <activatedEnv>pro</activatedEnv>
                <swgEnable>true</swgEnable>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <includeSystemScope>true</includeSystemScope>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 光明 jar包 -->
        <profile>
            <id>gm-jar</id>
            <properties>
                <project.packaging>jar</project.packaging>
                <activatedEnv>gm</activatedEnv>
                <swgEnable>false</swgEnable>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <includeSystemScope>true</includeSystemScope>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

