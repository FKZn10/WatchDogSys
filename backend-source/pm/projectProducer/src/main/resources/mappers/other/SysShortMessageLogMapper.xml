<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.other.SysShortMessageLogMapper">
    <select id="selectSysShortMessage"
            resultType="com.jpmsoft.projectProducer.pojo.entity.other.SysShortMessageLog">
        select * from sys_short_message_log
        <where>
            <if test="id!=null">
                and Sml_FileId=#{id}
            </if>
            <if test="contentType!=null">
                and Sml_Content like  concat('%',#{contentType},'%')
            </if>
            <if test="code!=null">
                and Sml_Content like  concat('%',#{code},'%')
            </if>
        </where>
    </select>
</mapper>