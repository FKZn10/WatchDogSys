<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.completion.CompletionFilingMapper">

    <select id="getCompletionFilingById"
            resultType="com.jpmsoft.common.model.response.Completion.CompletionFilingResponse">
        select
        con.Con_Name as conName,
        con.Con_Code as conCode,
        pro.P_Name as pName,
        c1.C_Name as cfContractorName,
        c1.C_Abbreviation as cfContractorAbbName,
        sec.Sec_Name as secName,
        f.file_relation_id as fileRelationId,
        mn.*
        from  Completion_Filing mn
        left join  Con_Contract con on con.Con_Id=mn.Con_Id
        left join  Pre_Project pro on pro.P_Id=mn.P_Id
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  SYS_Company c1 on c1.C_Id=mn.Cf_Contractor_Id
        left join  Sys_File f on f.FileID=mn.Cf_Id
        where mn.Cf_Id=#{cfId}
    </select>


    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id=#{params.pId}
        </if>
        <if test="params.secId!=null">
            and mn.Sec_Id=#{params.secId}
        </if>
        <if test="params.cfContractorId!=null">
            and mn.Cf_Contractor_Id=#{params.cfContractorId}
        </if>
        <if test="params.cfType!=null">
            and mn.Cf_Type=#{params.cfType}
        </if>
        <if test="params.cfState!=null">
            and mn.Cf_State=#{params.cfState}
        </if>
        <if test="params.cfCreateUname!=null">
            and mn.Cf_Create_Uname like concat('%',#{params.cfCreateUname},'%')
        </if>
        <if test="params.pName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likePname(#{params.pName},pro.P_Id)=true
                </when>
                <otherwise>
                    and pro.P_Name like concat('%',#{params.pName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.conName!=null">
            and con.Con_Name like concat('%',#{params.conName},'%')
        </if>
        <!--区间筛选-->
        <if test="params.cfCreateTimeStart!=null">
            and mn.Cf_Create_Time > #{params.cfCreateTimeStart}
        </if>
        <if test="params.cfCreateTimeEnd!=null">
            and mn.Cf_Create_Time &lt; #{params.cfCreateTimeEnd}
        </if>
    </sql>
    <select id="getCompletionFilingList"
            resultType="com.jpmsoft.common.model.response.Completion.CompletionFilingResponse">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        con.Con_Name as conName,
        con.Con_Code as conCode,
        c1.C_Name as cfContractorNameHistory,
        c1.C_Name as cfContractorName,
        c1.C_Abbreviation as cfContractorAbbName,
        sec.Sec_Name as secName,
        mn.*
        from  Completion_Filing mn
        left join  Con_Contract con on con.Con_Id=mn.Con_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  SYS_Company c1 on c1.C_Id=mn.Cf_Contractor_Id
        <if test="params.authSql!=null">
            ${params.authSql}
        </if>
        <if test="params.authSql==null">
            where 1=1
        </if>
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Cf_Create_Time DESC
            </otherwise>
        </choose>
    </select>
</mapper>