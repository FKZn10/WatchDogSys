<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.visaChange.ConDcoMapper">

    <select id="getConDcoByDcoId" resultType="com.jpmsoft.common.model.response.DesignChange.ConDcoResponse">
        select
        con.Con_Name as conName,
        con.Con_Code as conCode,
        pro.P_Name as pName,
        proc.C_Name as pConstructionUnitName,
        proc.C_Abbreviation as pConsAbbName,
        prod.D_Name as pCompetentDepartmentName,
        d.D_Name as dcoDepName,
        c1.C_Name as dcoConstructionUnitName,
        c2.C_Name as dcoDesignUnitName,
        c3.C_Name as dcoSupervisorName,
        c4.C_Name as dcoContractorName,
        c5.C_Name as dcoProposeName,
        c1.C_Abbreviation as dcoConsAbbName,
        c2.C_Abbreviation as dcoDesignAbbName,
        c3.C_Abbreviation as dcoSupervisorAbbName,
        c4.C_Abbreviation as dcoContractorAbbName,
        enis.Enis_Code as enisCode,
        enis.Enis_Location as enisLocation,
        f.file_relation_id as fileRelationId,
        mn.*
        from  Con_Dco mn
        left join  Con_Contract con on con.Con_Id=mn.Con_Id
        left join  Pre_Project pro on pro.P_Id=mn.P_Id
        left join SYS_Company proc on proc.C_Id=pro.P_Construction_Unit
        left join SYS_Department prod on prod.D_Id=pro.P_Competent_Department
        left join SYS_Department d on d.D_Id=mn.Dco_Dep
        left join  SYS_Company c1 on mn.Dco_Construction_Unit_Id=c1.C_Id
        left join  SYS_Company c2 on mn.Dco_Design_Unit_Id=c2.C_Id
        left join  SYS_Company c3 on mn.Dco_Supervisor_Id=c3.C_Id
        left join  SYS_Company c4 on mn.Dco_Contractor_Id=c4.C_Id
        left join SYS_Company c5 on mn.Dco_Propose_Id=c5.C_Id
        left join  Con_Enis enis on enis.Enis_Id=mn.Enis_Id
        left join  Sys_File f on f.FileID=mn.Dco_Id
        where mn.Dco_Id=#{dcoId}
    </select>

    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.dcoExceedBudget!=null">
            and mn.Dco_Exceed_Budget=#{params.dcoExceedBudget}
        </if>
        <if test="params.dcoIncrease!=null">
            and mn.Dco_Increase=#{params.dcoIncrease}
        </if>
        <if test="params.conId!=null">
            and mn.Con_Id=#{params.conId}
        </if>
        <if test="params.dcoMainCode!=null">
            and mn.Dco_Main_Code=#{params.dcoMainCode}
        </if>
        <if test="params.dcoSubCode!=null">
            and mn.Dco_Sub_Code=#{params.dcoSubCode}
        </if>
        <if test="params.pId!=null">
            and pro.P_Id=#{params.pId}
        </if>
        <if test="params.dcoState!=null">
            and mn.Dco_State=#{params.dcoState}
        </if>
        <if test="params.dcoGrade!=null">
            and mn.Dco_Grade=#{params.dcoGrade}
        </if>
        <if test="params.dcoYesNo!=null">
            and mn.Dco_Yes_No=#{params.dcoYesNo}
        </if>
        <if test="params.dcoIsHistory!=null">
            and mn.Dco_Is_History=#{params.dcoIsHistory}
        </if>
        <if test="params.dcoDep!=null">
            and mn.Dco_Dep=#{params.dcoDep}
        </if>
        <if test="params.dcoContent!=null">
            and mn.Dco_Content like concat('%',#{params.dcoContent},'%')
        </if>
        <if test="params.dcoCode!=null">
            and mn.Dco_Code like concat('%',#{params.dcoCode},'%')
        </if>
        <if test="params.dcoName!=null">
            and mn.Dco_Name like concat('%',#{params.dcoName},'%')
        </if>
        <if test="params.dcoProjectName!=null">
            and mn.Dco_Project_Name like concat('%',#{params.dcoProjectName},'%')
        </if>
        <if test="params.dcoMajor!=null">
            and mn.Dco_Major like concat('%',#{params.dcoMajor},'%')
        </if>
        <if test="params.dcoCreateUname!=null">
            and mn.Dco_Create_Uname like concat('%',#{params.dcoCreateUname},'%')
        </if>
        <if test="params.enisCode!=null">
            and enis.Enis_Code like concat('%',#{params.enisCode},'%')
        </if>
        <if test="params.enisLocation!=null">
            and enis.Enis_Location like concat('%',#{params.enisLocation},'%')
        </if>
        <if test="params.dcoConstructionUnitName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likeCname(#{params.dcoConstructionUnitName},c1.C_Id)=true
                </when>
                <otherwise>
                    and c1.C_Name like concat('%',#{params.dcoConstructionUnitName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.dcoDesignUnitName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likeCname(#{params.dcoDesignUnitName},c2.C_Id)=true
                </when>
                <otherwise>
                    and c2.C_Name like concat('%',#{params.dcoDesignUnitName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.dcoSupervisorName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likeCname(#{params.dcoSupervisorName},c3.C_Id)=true
                </when>
                <otherwise>
                    and c3.C_Name like concat('%',#{params.dcoSupervisorName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.dcoContractorName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likeCname(#{params.dcoContractorName},c4.C_Id)=true
                </when>
                <otherwise>
                    and c4.C_Name like concat('%',#{params.dcoContractorName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.dcoDepName!=null">
            and d.D_Name like concat('%',#{params.dcoDepName},'%')
        </if>
        <if test="params.pName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likePname(#{params.pName},pro.P_Id)=true
                </when>
                <otherwise>
                    and pro.P_Name like concat('%',#{params.pName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.conName!=null">
            and con.Con_Name like concat('%',#{params.conName},'%')
        </if>
        <!--区间筛选-->
        <if test="params.dcoCreateTimeStart!=null">
            and mn.Dco_Create_Time > #{params.dcoCreateTimeStart}
        </if>
        <if test="params.dcoCreateTimeEnd!=null">
            and mn.Dco_Create_Time &lt; #{params.dcoCreateTimeEnd}
        </if>
        <if test="params.dcoEstimateStart!=null">
            and mn.Dco_Estimate > #{params.dcoEstimateStart}
        </if>
        <if test="params.dcoEstimateEnd!=null">
            and mn.Dco_Estimate &lt; #{params.dcoEstimateEnd}
        </if>
        <if test="params.dcoDateStart!=null">
            and mn.Dco_Date > #{params.dcoDateStart}
        </if>
        <if test="params.dcoDateEnd!=null">
            and mn.Dco_Date &lt; #{params.dcoDateEnd}
        </if>
        <if test="params.filterGrade==true">
           and (mn.Dco_Grade!='01' or (mn.Dco_Grade=='01' and mn.Dco_Id in
           (select Dco_Id from Con_Ecm where Ecm_State=7)
           ))
        </if>
        <if test="params.filterDcBudget==true">
           and  (select count(*) from Con_Dc_Budget scdb where scdb.Dco_Id=mn.Dco_Id and scdb.Dcb_State!=3) &lt; 1
        </if>
        <if test="params.filterConECFee != null and params.filterConECFee == '01'">
            and not exists(select 1 from Con_EC_Fee cef where cef.Dco_Id = mn.Dco_Id and cef.Ecf_State != 3 and cef.Ecf_State != 0)
        </if>
    </sql>

    <select id="getConDcoList" resultType="com.jpmsoft.common.model.response.DesignChange.ConDcoResponse">
        select
        con.Con_Name as conName,
        con.Con_Code as conCode,
        con.Con_Money_Total as conMoneyTotal,
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        d.D_Name as dcoDepName,
        c1.C_Name_History as dcoConstructionUnitNameHistory,
        c2.C_Name_History as dcoDesignUnitNameHistory,
        c3.C_Name_History as dcoSupervisorNameHistory,
        c4.C_Name_History as dcoContractorNameHistory,
        c1.C_Name as dcoConstructionUnitName,
        c2.C_Name as dcoDesignUnitName,
        c3.C_Name as dcoSupervisorName,
        c4.C_Name as dcoContractorName,
        c5.C_Name as dcoProposeName,
        c1.C_Abbreviation as dcoConsAbbName,
        c2.C_Abbreviation as dcoDesignAbbName,
        c3.C_Abbreviation as dcoSupervisorAbbName,
        c4.C_Abbreviation as dcoContractorAbbName,
        enis.Enis_Code as enisCode,
        enis.Enis_Type as enisType,
        enis.Enis_Location as enisLocation,
        (select cdb.Dcb_Estimate_Amt from Con_Dc_Budget cdb where cdb.Dco_Id=mn.Dco_Id and cdb.Dcb_State=7 limit 1) as  dcbEstimateAmt,
        mn.*
        from Con_Dco mn
        left join Con_Contract con on con.Con_Id=mn.Con_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join SYS_Department d on d.D_Id=mn.Dco_Dep
        left join SYS_Company c1 on mn.Dco_Construction_Unit_Id=c1.C_Id
        left join SYS_Company c2 on mn.Dco_Design_Unit_Id=c2.C_Id
        left join SYS_Company c3 on mn.Dco_Supervisor_Id=c3.C_Id
        left join SYS_Company c4 on mn.Dco_Contractor_Id=c4.C_Id
        left join SYS_Company c5 on mn.Dco_Propose_Id=c5.C_Id
        left join Con_Enis enis on enis.Enis_Id=mn.Enis_Id
        <if test="params.authSql!=null">
            ${params.authSql}
        </if>
        <if test="params.authSql==null">
            where 1=1
        </if>
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Dco_Create_Time desc
            </otherwise>
        </choose>
    </select>
</mapper>