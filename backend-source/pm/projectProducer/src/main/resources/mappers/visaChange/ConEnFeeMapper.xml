<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.visaChange.ConEnFeeMapper">

    <select id="getConEnFeeById" resultType="com.jpmsoft.projectProducer.pojo.dto.visaChange.ConEnFeeDTO">
        select
        con.Con_Name as conName,
        con.Con_Code as conCode,
        con.Con_Money_Total as conMoneyTotal,
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        c1.C_Name as cefContractorName,
        c2.C_Name as cefSupervisorName,
        c3.C_Name as cefApplicantName,
        enis.Enis_Name as enisName,
        mn.*
        from Con_En_Fee mn
        left join Con_Contract con on con.Con_Id=mn.Con_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join SYS_Company c1 on mn.Cef_Contractor_Id=c1.C_Id
        left join SYS_Company c2 on mn.Cef_Supervisor_Id=c2.C_Id
        left join SYS_Company c3 on mn.Cef_Applicant=c3.C_Id
        left join Con_Enis enis on mn.Enis_Id=enis.Enis_Id
        where mn.id=#{id}
    </select>

    <select id="getConEnFeeList" resultType="com.jpmsoft.projectProducer.pojo.dto.visaChange.ConEnFeeDTO">
        select
        con.Con_Name as conName,
        con.Con_Code as conCode,
        con.Con_Money_Total as conMoneyTotal,
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        c1.C_Name as cefContractorName,
        c2.C_Name as cefSupervisorName,
        c3.C_Name as cefApplicantName,
        enis.Enis_Name as enisName,
        enis.Enis_Code as enisCode,
        enis.Enis_Project_Name as enisProjectName,
        enis.Enis_Sub_Code as enisSubCode,
        mn.*
        from Con_En_Fee mn
        left join Con_Contract con on con.Con_Id=mn.Con_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join SYS_Company c1 on mn.Cef_Contractor_Id=c1.C_Id
        left join SYS_Company c2 on mn.Cef_Supervisor_Id=c2.C_Id
        left join SYS_Company c3 on mn.Cef_Applicant=c3.C_Id
        left join Con_Enis enis on mn.Enis_Id=enis.Enis_Id
        ${params.authSql}
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Create_Time desc
            </otherwise>
        </choose>
    </select>

    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id=#{params.pId}
        </if>
        <if test="params.state!=null">
            and mn.State=#{params.state}
        </if>
        <if test="params.cefCode!=null">
            and INSTR(mn.Cef_Code,#{params.cefCode})
        </if>
        <if test="params.createUname!=null">
            and INSTR(mn.Create_Uname,#{params.createUname})
        </if>
        <if test="params.enisName!=null">
            and INSTR(enis.Enis_Name,#{params.enisName})
        </if>
        <if test="params.enisCode!=null">
            and INSTR(enis.Enis_Code,#{params.enisCode})
        </if>
        <if test="params.enisProjectName!=null">
            and INSTR(enis.Enis_Project_Name,#{params.enisProjectName})
        </if>
        <if test="params.enisSubCode!=null">
            and INSTR(enis.Enis_Sub_Code,#{params.enisSubCode})
        </if>
        <if test="params.pName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likePname(#{params.pName},pro.P_Id)=true
                </when>
                <otherwise>
                    and INSTR(pro.P_Name,#{params.pName})
                </otherwise>
            </choose>
        </if>
        <if test="params.conName!=null">
            and INSTR(con.Con_Name,#{params.conName})
        </if>
    </sql>
</mapper>