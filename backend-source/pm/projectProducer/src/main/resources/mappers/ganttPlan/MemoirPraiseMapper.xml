<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.ganttPlan.MemoirPraiseMapper">

    <select id="selectByMiIds" resultType="com.jpmsoft.projectProducer.pojo.dto.ganttPlan.MemoirPraiseDTO">
        select
            c1.c_name as mpCpyName,
            mn.*
        from memoir_praise mn
        left join Sys_Company c1 on c1.c_id=mn.mp_cpy
        where mn.mi_id in
        <foreach collection="miIds" separator="," item="miId" open="(" close=")">
            #{miId}
        </foreach>
        order by mn.mp_sort asc
    </select>
</mapper>