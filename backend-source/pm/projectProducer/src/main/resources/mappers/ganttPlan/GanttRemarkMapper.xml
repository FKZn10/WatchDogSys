<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.ganttPlan.GanttRemarkMapper">
    <select id="getGanttRemarkList" resultType="com.jpmsoft.common.model.response.ganttPlan.GanttRemarkResponse">
        select id, gms_id, write_time, remark, create_user, create_user_name
        from gantt_remark
        where Gms_Id = #{params.gmsId}
    </select>
</mapper>