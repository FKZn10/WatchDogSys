<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.ganttPlan.GanttLinksMapper">

    <select id="getLinksByPlanId" resultType="com.jpmsoft.common.model.response.Plan.GanttLinksResponse">
        select
            gt.Task_Text as linkSourceName,
            mn.*
        from Gantt_Links mn
        left join Gantt_Tasks gt on gt.Task_Id=mn.Link_Source
        where mn.Plan_Id=#{planId}
    </select>
</mapper>