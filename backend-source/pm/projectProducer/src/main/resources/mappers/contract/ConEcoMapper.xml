<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.contract.ConEcoMapper">

    <select id="getConEcoById" resultType="com.jpmsoft.projectProducer.pojo.dto.contract.ConEcoDTO">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        con.Con_Name as conName,
        con.Con_Code as conCode,
        con.Con_Money_Total as conMoneyTotal,
        ec.Ec_Name as ecName,
        ec.Ec_Code as ecCode,
        c1.C_Name as ecoPartyName,
        mn.*
        from Con_Eco mn
        left join Sys_Company c1 on c1.C_Id=mn.Eco_Party_Cid
        left join Con_Contract con on con.Con_Id = mn.Con_Id
        left join Con_EC ec on ec.Ec_Id=mn.Ec_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        where mn.Eco_Id=#{ecoId}
    </select>


    <select id="getConEcoList" resultType="com.jpmsoft.projectProducer.pojo.dto.contract.ConEcoDTO">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        con.Con_Name as conName,
        con.Con_Code as conCode,
        con.Con_Money_Total as conMoneyTotal,
        ec.Ec_Name as ecName,
        ec.Ec_Code as ecCode,
        c1.C_Name as ecoPartyName,
        mn.*
        from Con_Eco mn
        left join Sys_Company c1 on c1.C_Id=mn.Eco_Party_Cid
        left join Con_Contract con on con.Con_Id = mn.Con_Id
        left join Con_EC ec on ec.Ec_Id=mn.Ec_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        ${params.authSql}
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Eco_Create_Time DESC
            </otherwise>
        </choose>
    </select>

    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id = #{params.pId}
        </if>
        <if test="params.ecoState!=null">
            and mn.Eco_State = #{params.ecoState}
        </if>
        <if test="params.ecoCode!=null">
            and INSTR(mn.Eco_Code,#{params.ecoCode})
        </if>
        <if test="params.ecoEngineerName!=null">
            and INSTR(mn.Eco_Engineer_Name,#{params.ecoEngineerName})
        </if>
        <if test="params.ecoCreateUname!=null">
            and INSTR(mn.Eco_Create_Uname,#{params.ecoCreateUname})
        </if>
        <if test="params.pName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likePname(#{params.pName},pro.P_Id)=true
                </when>
                <otherwise>
                    and INSTR(pro.P_Name,#{params.pName})
                </otherwise>
            </choose>
        </if>
        <if test="params.pCode!=null">
            and INSTR(pro.P_Code,#{params.pCode})
        </if>
        <if test="params.conName!=null">
            and INSTR(con.Con_Name,#{params.conName})
        </if>
        <if test="params.conCode!=null">
            and INSTR(con.Con_Code,#{params.conCode})
        </if>
        <if test="params.ecName!=null">
            and INSTR(ec.Ec_Name,#{params.ecName})
        </if>
        <if test="params.ecCode!=null">
            and INSTR(ec.Ec_Code,#{params.ecCode})
        </if>
        <if test="params.ecoPartyName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likeCname(#{params.ecoPartyName},c1.C_Id)=true
                </when>
                <otherwise>
                    and INSTR(c1.C_Name,#{params.ecoPartyName})
                </otherwise>
            </choose>
        </if>
    </sql>
</mapper>