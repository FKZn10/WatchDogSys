<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.contract.AgentActualAllocationMapper">

    <select id="getAgentActualAllocationById"
            resultType="com.jpmsoft.common.model.requestAndResponse.Contract.AgentActualAllocationModel">
        select
        con.Con_Name as conName,
        pro.P_Name as pName,
        pro.P_Code as pCode,
        proc.C_Name as pConstructionUnitName,
        proc.C_Abbreviation as pConsAbbName,
        prod.D_Name as pCompetentDepartmentName,
        sr.Sc_Title as scTitle,
        sr.Sc_Name as scName,
        c1.C_Name as aalApplicantName,
        c1.C_Abbreviation as aalApplicantAbbName,
        f.file_relation_id as fileRelationId,
        mn.*
        from  Agent_Actual_Allocation mn
        left join  Con_Contract con on con.Con_Id=mn.Con_Id
        left join  Sys_Company c1 on c1.C_Id=mn.Aal_Applicant
        left join  Pre_Project pro on pro.P_Id=mn.P_Id
        left join SYS_Company proc on proc.C_Id=pro.P_Construction_Unit
        left join SYS_Department prod on prod.D_Id=pro.P_Competent_Department
        left join  Subcontract_Record sr on sr.Sc_Id=mn.Aal_Agent_Con_Id
        left join  Sys_File f on f.FileID=mn.Aal_Id
        where mn.Aal_Id=#{aalId}
    </select>

    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id=#{params.pId}
        </if>
        <if test="params.aalPayType!=null">
            and mn.Aal_Pay_Type=#{params.aalPayType}
        </if>
        <if test="params.aalAgentConType!=null">
            and mn.Aal_Agent_Con_Type=#{params.aalAgentConType}
        </if>
        <if test="params.aalState!=null">
            and mn.Aal_State=#{params.aalState}
        </if>
        <if test="params.aalCreateUname!=null">
            and mn.Aal_Create_Uname like concat('%',#{params.aalCreateUname},'%')
        </if>
        <if test="params.aalAgentConCode!=null">
            and mn.Aal_Agent_Con_Code like concat('%',#{params.aalAgentConCode},'%')
        </if>
        <if test="params.aalConCode!=null">
            and mn.Aal_Con_Code like concat('%',#{params.aalConCode},'%')
        </if>
        <if test="params.aalContacts!=null">
            and mn.Aal_Contacts like concat('%',#{params.aalContacts},'%')
        </if>
        <if test="params.aalContactTelephone!=null">
            and mn.Aal_Contact_Telephone like concat('%',#{params.aalContactTelephone},'%')
        </if>
        <if test="params.pName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likePname(#{params.pName},mn.P_Id)=true
                </when>
                <otherwise>
                    and pro.P_Name like concat('%',#{params.pName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.pCode!=null">
            and pro.P_Code like concat('%',#{params.pCode},'%')
        </if>
        <if test="params.conName!=null">
            and con.Con_Name like concat('%',#{params.conName},'%')
        </if>
    </sql>

    <select id="getAgentActualAllocationList"
            resultType="com.jpmsoft.common.model.requestAndResponse.Contract.AgentActualAllocationModel">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        con.Con_Name as conName,
        sr.Sc_Title as scTitle,
        sr.Sc_Name as scName,
        c1.C_Name as aalApplicantName,
        c1.C_Abbreviation as aalApplicantAbbName,
        mn.*
        from  Agent_Actual_Allocation mn
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Con_Contract con on con.Con_Id=mn.Con_Id
        left join  Sys_Company c1 on c1.C_Id=mn.Aal_Applicant
        left join  Subcontract_Record sr on sr.Sc_Id=mn.Aal_Agent_Con_Id
        <if test="params.authSql!=null">
            ${params.authSql}
        </if>
        <if test="params.authSql==null">
            where 1=1
        </if>
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Aal_Create_Time desc
            </otherwise>
        </choose>
    </select>

</mapper>