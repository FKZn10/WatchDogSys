<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.contract.ConEstimateMaintenanceMapper">

    <resultMap type="com.jpmsoft.common.model.request.Contract.ConEstimateMaintenanceRequest"
               id="getConEstimateMaintenances">
        <id column="Cem_Id" property="cemId"/>
        <collection property="conEstimateMaintenanceDtlModel"
                    ofType="com.jpmsoft.common.model.requestAndResponse.Contract.ConEstimateMaintenanceDtlModel"
                    column="Cem_Id" select="getConEstimateMaintenanceDtlModel">
        </collection>
    </resultMap>

    <select id="getConEstimateMaintenanceDtlModel"
            resultType="com.jpmsoft.common.model.requestAndResponse.Contract.ConEstimateMaintenanceDtlModel">
        select
            cemd.*
        from   Con_Estimate_Maintenance_Dtl cemd
        where cemd.Cem_Id=#{cemId}
    </select>


    <select id="getConEstimateMaintenanceById" resultType="com.jpmsoft.common.model.request.Contract.ConEstimateMaintenanceRequest" resultMap="getConEstimateMaintenances">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        con.Con_Name as conName,
        con.Con_Code as conCode,
        con.Con_Money_Total as conMoneyTotal,
        sec.Sec_Name as secName,
        mn.*
        from Con_Estimate_Maintenance mn
        left join Con_Contract con on con.Con_Id = mn.Con_Id
        left join Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        where mn.Cem_Id=#{cemId}
    </select>

    <select id="getConEstimateMaintenanceByConIdAndSecId" resultType="com.jpmsoft.common.model.requestAndResponse.Contract.ConEstimateModel">
        select
        mn.*
        from Con_Estimate mn
        left join Con_Contract con on con.Con_Id = mn.Con_Id
        where mn.Con_Id=#{conId} and con.Con_Section_Id=#{secId} and con.Con_Approval_State=7
    </select>


    <select id="getConEstimateMaintenanceList" resultType="com.jpmsoft.common.model.request.Contract.ConEstimateMaintenanceRequest">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        con.Con_Name as conName,
        con.Con_Code as conCode,
        con.Con_Money_Total as conMoneyTotal,
        sec.Sec_Name as secName,
        mn.*
        from Con_Estimate_Maintenance mn
        left join Con_Contract con on con.Con_Id = mn.Con_Id
        left join Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        ${params.authSql}
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Create_Time DESC
            </otherwise>
        </choose>
    </select>

    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id = #{params.pId}
        </if>
        <if test="params.state!=null">
            and mn.State = #{params.state}
        </if>
        <if test="params.createUname!=null">
            and INSTR(mn.Create_User_Name,#{params.createUname})
        </if>
        <if test="params.pName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likePname(#{params.pName},pro.P_Id)=true
                </when>
                <otherwise>
                    and INSTR(pro.P_Name,#{params.pName})
                </otherwise>
            </choose>
        </if>
        <if test="params.pCode!=null">
            and INSTR(pro.P_Code,#{params.pCode})
        </if>
        <if test="params.conName!=null">
            and INSTR(con.Con_Name,#{params.conName})
        </if>
        <if test="params.conCode!=null">
            and INSTR(con.Con_Code,#{params.conCode})
        </if>
    </sql>
</mapper>