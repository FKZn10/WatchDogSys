<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.archive.ArchiveFilingApplyMapper">

    <select id="getArchiveFilingApplyById"
            resultType="com.jpmsoft.common.model.requestAndResponse.Archive.ArchiveFilingApplyModel">
        select
        pro.P_Name as pName,
        pro.P_Name_History as pNameHistory,
        c.C_Name as faManageUnitName,
        c.C_Name_History as faManageUnitNameHistory,
        c.C_Abbreviation as faManageUnitAbbName,
        con.Con_Name as conName,
        proc.C_Name as pConstructionUnitName,
        proc.C_Abbreviation as pConsAbbName,
        prod.D_Name as pCompetentDepartmentName,
        f.file_relation_id as fileRelationId,
        mn.*
        from  Archive_Filing_Apply mn
        left join  Pre_Project pro on pro.P_Id=mn.P_Id
        left join SYS_Company proc on proc.C_Id=pro.P_Construction_Unit
        left join SYS_Department prod on prod.D_Id=pro.P_Competent_Department
        left join  Con_Contract con on con.Con_Id=mn.Con_Id
        left join  Sys_Company c on c.C_Id=mn.Fa_Manage_Unit_Id
        left join  Sys_File f on f.FileID=mn.Fa_Id
        where mn.Fa_Id=#{faId}
    </select>


    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id=#{params.pId}
        </if>
        <if test="params.faState!=null">
            and mn.Fa_State=#{params.faState}
        </if>
        <if test="params.faType!=null">
            and mn.Fa_Type=#{params.faType}
        </if>
        <if test="params.faSourceFunds!=null">
            and mn.Fa_Source_Funds=#{params.faSourceFunds}
        </if>
        <if test="params.pName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likePname(#{params.pName},mn.P_Id)=true
                </when>
                <otherwise>
                    and pro.P_Name like concat('%',#{params.pName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.faManageUnitName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likeCname(#{params.faManageUnitName},mn.Fa_Manage_Unit_Id)=true
                </when>
                <otherwise>
                    and c.C_Name like concat('%',#{params.faManageUnitName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.conName!=null">
            and con.Con_Name like concat('%',#{params.conName},'%')
        </if>
        <if test="params.faPmName!=null">
            and mn.Fa_Pm_Name like concat('%',#{params.faPmName},'%')
        </if>
        <if test="params.faAgentConstructionUnitName!=null">
            and mn.Fa_Agent_Construction_Unit_Name like concat('%',#{params.faAgentConstructionUnitName},'%')
        </if>
        <if test="params.faConstructionUnitName!=null">
            and mn.Fa_Construction_Unit_Name like concat('%',#{params.faConstructionUnitName},'%')
        </if>
        <if test="params.faSurveyUnitName!=null">
            and mn.Fa_Survey_Unit_Name like concat('%',#{params.faSurveyUnitName},'%')
        </if>
        <if test="params.faDesignUnitName!=null">
            and mn.Fa_Design_Unit_Name like concat('%',#{params.faDesignUnitName},'%')
        </if>
        <if test="params.faConsultUnitName!=null">
            and mn.Fa_Consult_Unit_Name like concat('%',#{params.faConsultUnitName},'%')
        </if>
        <if test="params.faSupervisorUnitName!=null">
            and mn.Fa_Supervisor_Unit_Name like concat('%',#{params.faSupervisorUnitName},'%')
        </if>
    </sql>

    <select id="getArchiveFilingApplyList"
            resultType="com.jpmsoft.common.model.requestAndResponse.Archive.ArchiveFilingApplyModel">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        c.C_Name as faManageUnitName,
        c.C_Name_History as faManageUnitNameHistory,
        c.C_Abbreviation as faManageUnitAbbName,
        con.Con_Name as conName,
        mn.*
        from  Archive_Filing_Apply mn
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Con_Contract con on con.Con_Id=mn.Con_Id
        left join  Sys_Company c on c.C_Id=mn.Fa_Manage_Unit_Id
        ${params.authSql}
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Fa_Create_Time DESC
            </otherwise>
        </choose>
    </select>

</mapper>