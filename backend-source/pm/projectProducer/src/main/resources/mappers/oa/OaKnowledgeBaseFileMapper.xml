<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.oa.OaKnowledgeBaseFileMapper">

    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.kbfType!=null">
            and mn.Kbf_Type=#{params.kbfType}
        </if>
        <if test="params.kbfState!=null">
            and mn.Kbf_State=#{params.kbfState}
        </if>
        <if test="params.kbfName!=null">
            and mn.Kbf_Name like concat('%',#{params.kbfName},'%')
        </if>
        <if test="params.kbfTitle!=null">
            and mn.Kbf_Title like concat('%',#{params.kbfTitle},'%')
        </if>
        <if test="params.kbfVersionNumber!=null">
            and mn.Kbf_Version_Number like concat('%',#{params.kbfVersionNumber},'%')
        </if>
        <if test="params.kbfCreateUname!=null">
            and mn.Kbf_Create_Uname like concat('%',#{params.kbfCreateUname},'%')
        </if>
        <if test="params.kbfCode!=null">
            and mn.Kbf_Code like concat('%',#{params.kbfCode},'%')
        </if>
        <if test="params.partyAsUnitName!=null">
            and mn.party_As_Unit_Name like concat('%',#{params.partyAsUnitName},'%')
        </if>
        <if test="params.kbfPublishDate0!=null">
            AND TO_DAYS(mn.Kbf_Publish_Date) >= TO_DAYS(#{params.kbfPublishDate0,jdbcType=DATE})
        </if>
        <if test="params.kbfPublishDate1!=null">
            AND TO_DAYS(mn.Kbf_Publish_Date) &lt;= TO_DAYS(#{params.kbfPublishDate1,jdbcType=DATE})
        </if>
        <if test="kbIds!=null">
            and mn.Kb_Id in
            <foreach collection="kbIds" open="(" close=")" separator="," item="kbId">
                #{kbId}
            </foreach>
        </if>
    </sql>

    <select id="getOaKnowledgeBaseFileList"
            resultType="com.jpmsoft.common.model.requestAndResponse.Oa.OaKnowledgeBaseFileModel">
        select
        mn.*
        from  OA_Knowledge_Base_File mn
        where 1=1
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Kbf_Create_Time desc
            </otherwise>
        </choose>
        limit #{params.start},#{params.size}
    </select>

    <select id="getOaKnowledgeBaseFileListCount" resultType="java.lang.Integer">
        select
        count(1)
        from  OA_Knowledge_Base_File mn
        where 1=1
        <include refid="listFilter"/>
    </select>

    <select id="getOaKnowledgeBaseFileAllList"
            resultType="com.jpmsoft.common.model.requestAndResponse.Oa.OaKnowledgeBaseFileModel">
        select
            mn.*
        from  OA_Knowledge_Base_File mn
        <if test="teId!=null">
            and mn.Te_Id = #{teId}
        </if>
        order by Kbf_Create_Time desc
    </select>
</mapper>