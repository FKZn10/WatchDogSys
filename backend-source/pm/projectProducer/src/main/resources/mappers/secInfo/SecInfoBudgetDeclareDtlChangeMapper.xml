<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.secInfo.SecInfoBudgetDeclareDtlChangeMapper">


    <delete id="delBySicId">
      delete from  Sec_Info_Budget_Declare_Dtl_Change where sic_id in
      <foreach collection="sicIdList" index="index" item="item" open="(" separator="," close=")">
        #{item}
      </foreach>
    </delete>

    <select id="getSecInfoBudgetDeclareDtlChangeList"
            resultType="com.jpmsoft.common.model.response.SecInfo.SecInfoBudgetDeclareDtlChangeRes">
        select * from Sec_Info_Budget_Declare_Dtl_Change
        <where>
            <if test="sicIdList != null and sicIdList.size()>0 ">
                and sic_id in
                 <foreach collection="sicIdList" index="index" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

</mapper>