<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.secInfo.SecInviteDetailMapper">
    <select id="getSecInviteDetailByWsIds" resultType="com.jpmsoft.common.model.request.SecInfo.SecInviteDetailDTO">
        select
        c1.C_Name as cName,
        mn.*
        from Sec_Invite_Detail mn
        left join SYS_Company c1 on c1.C_Id=mn.C_Id
        where mn.Ws_Id in
        <foreach collection="wsIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
        order by mn.Sir_Sort ASC
    </select>

    <select id="getSecInviteDetailBySirIds" resultType="com.jpmsoft.common.model.request.SecInfo.SecInviteDetailDTO">
        select
        c1.C_Name as cName,
        mn.*
        from Sec_Invite_Detail mn
        left join SYS_Company c1 on c1.C_Id=mn.C_Id
        where mn.sir_Id in
        <foreach collection="sirIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
        order by mn.Sir_Sort ASC
    </select>
</mapper>