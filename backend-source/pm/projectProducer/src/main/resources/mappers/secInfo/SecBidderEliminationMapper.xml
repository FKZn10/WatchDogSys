<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.secInfo.SecBidderEliminationMapper">

    <resultMap type="com.jpmsoft.common.model.requestAndResponse.SecInfo.SecBidderEliminationModel"
               id="SecBidderEliminationModel">
        <id column="Sbe_Id" property="sbeId"/>
        <collection property="secProjects" ofType="com.jpmsoft.common.model.response.SecInfo.SecProjectResponse"
                    column="Sbe_Id" select="getSecInfoProject">
        </collection>
    </resultMap>


    <select id="getSecInfoProject" resultType="com.jpmsoft.common.model.response.SecInfo.SecProjectResponse">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        mn.*
        from   Sec_Project mn
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  Sec_Bidder_Elimination sd on sd.Sec_Id=sec.Sec_Id
        where sd.Sbe_Id=#{sbeId}
    </select>


    <select id="getSecBidderEliminationById" resultMap="SecBidderEliminationModel">
        select
        sec.Sec_Name as secName,
        sec.Sec_Code as secCode,
        sec.Sec_Type as secType,
        sec.Sec_Bidding_Type as secBiddingType,
        sn.N_Amount as nAmount,
        sn.N_Scope as nScope,
        sec.Sec_Start_Time as secStartTime,
        sec.Sec_End_Time as secEndTime,
        f.file_relation_id as fileRelationId,
        mn.*
        from  Sec_Bidder_Elimination mn
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  Sec_Notice sn on sn.Sec_Id=mn.Sec_Id
        left join  Sys_File f on f.FileID=mn.Sbe_Id
        where mn.Sbe_Id=#{sbeId}
    </select>


    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.secId!=null">
            and mn.Sec_Id = #{params.secId}
        </if>
        <if test="params.sbeState!=null">
            and mn.Sbe_State = #{params.sbeState}
        </if>
        <if test="params.secName!=null">
            and sec.Sec_Name like concat('%',#{params.secName},'%')
        </if>
        <if test="params.sbeCreateUname!=null">
            and mn.Sbe_Create_Uname like concat('%',#{params.sbeCreateUname},'%')
        </if>
        <!--区间筛选-->
        <if test="params.sbeCreateTimeStart!=null">
            and mn.Sbe_Create_Time > #{params.sbeCreateTimeStart}
        </if>
        <if test="params.sbeCreateTimeStart!=null">
            and mn.Sbe_Create_Time &lt; #{params.sbeCreateTimeStart}
        </if>
        <if test="params.secStartTimeStart!=null">
            and sec.Sec_Start_Time > #{params.secStartTimeStart}
        </if>
        <if test="params.secStartTimeEnd!=null">
            and sec.Sec_Start_Time &lt; #{params.secStartTimeEnd}
        </if>
        <if test="params.nAmountStart!=null">
            and sn.N_Amount > #{params.nAmountStart}
        </if>
        <if test="params.nAmountEnd!=null">
            and sn.N_Amount &lt; #{params.nAmountEnd}
        </if>
        <if test="params.sbeBiddersStart!=null">
            and mn.Sbe_Number_Bidders > #{params.sbeBiddersStart}
        </if>
        <if test="params.sbeBiddersEnd!=null">
            and mn.Sbe_Number_Bidders &lt; #{params.sbeBiddersEnd}
        </if>
        <if test="params.sbeBidLinksStart!=null">
            and mn.Sbe_Number_Bid_Links > #{params.sbeBidLinksStart}
        </if>
        <if test="params.sbeBidLinksEnd!=null">
            and mn.Sbe_Number_Bid_Links &lt; #{params.sbeBidLinksEnd}
        </if>
        <if test="params.sbeQualifiedStart!=null">
            and mn.Sbe_Number_Qualified > #{params.sbeQualifiedStart}
        </if>
        <if test="params.sbeQualifiedEnd!=null">
            and mn.Sbe_Number_Qualified &lt; #{params.sbeQualifiedEnd}
        </if>
    </sql>

    <select id="getSecBidderEliminationList" resultMap="SecBidderEliminationModel">
        select
        sec.Sec_Name as secName,
        sec.Sec_Code as secCode,
        sn.N_Amount as nAmount,
        sec.Sec_Start_Time as secStartTime,
        mn.*
        from  Sec_Bidder_Elimination mn
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  Sec_Notice sn on sn.Sec_Id=mn.Sec_Id
        where 1=1
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Sbe_Create_Time ASC
            </otherwise>
        </choose>
        limit #{params.start},#{params.size}
    </select>


    <select id="getSecBidderEliminationListCount" resultType="java.lang.Integer">
        select
        count(1)
        from  Sec_Bidder_Elimination mn
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  Sec_Notice sn on sn.Sec_Id=mn.Sec_Id
        where 1=1
        <include refid="listFilter"/>
    </select>
</mapper>