<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.secInfo.SecJGAgencySelectionRecordMapper">
    <resultMap type="com.jpmsoft.common.model.requestAndResponse.SecInfo.SecJGAgencySelectionRecordModel"
               id="getSecSelectionRecord">
        <id column="id" property="id"/>
        <collection property="secJGSelectionRecordDtlModels"
                    ofType="com.jpmsoft.common.model.requestAndResponse.SecInfo.SecJGAgencySelectionRecordDtlModel"
                    column="id" select="getSelectionRecordDtl">
        </collection>
    </resultMap>

    <select id="getSelectionRecordDtl"
            resultType="com.jpmsoft.common.model.requestAndResponse.SecInfo.SecJGAgencySelectionRecordDtlModel">
        select c1.C_Name         as cName,
               c1.C_Abbreviation as exContrAbbName,
               c1.C_Name_History as cNameHistory,
               mn.*,
               se.*
        from Sec_JG_Agency_Selection_Record_Dtl mn
                 left join Sec_JG_Expert se on mn.Ex_Id = se.id
                 left join Sys_Company c1 on c1.C_Id = se.C_Id
        where mn.Sr_Id = #{srId}
    </select>

    <select id="getSecSelectionRecordList"
            resultType="com.jpmsoft.common.model.requestAndResponse.SecInfo.SecJGAgencySelectionRecordModel">
        select
        c3.C_Name as srCompanyName,
        mn.*
        from Sec_JG_Agency_Selection_Record mn
        left join SYS_Company c3 on c3.C_Id = mn.Sr_Company
        ${params.authSql}
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Sr_Create_Time desc
            </otherwise>
        </choose>
    </select>

    <select id="getSecSelectionRecordById" resultMap="getSecSelectionRecord">
        select
            c3.C_Name as srCompanyName,
            mn.*
        from Sec_JG_Agency_Selection_Record mn
        left join SYS_Company c3 on c3.C_Id = mn.Sr_Company
        where mn.id = #{srId}
    </select>

    <select id="getSecExpertExtractById"
            resultType="com.jpmsoft.projectProducer.pojo.vo.secInfo.SecJGAgencyExpertExtractVo">
        select es.Es_Technology_Num        as esTechnologyNum,
               es.Es_Economics_Num         as esEconomicsNum,
               es.Es_Expert_Num            as esExpertNum,
               mn.state                    as srState,
               es.state                    as esState,
               es.*,
               mn.*
        from Sec_JG_Agency_Selection_Record mn
        left join Sec_JG_Expert_Select es on es.id = mn.Es_Id
        where mn.id = #{srId}
    </select>


    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id=#{params.pId}
        </if>
        <if test="params.srType!=null">
            and mn.Sr_Type=#{params.srType}
        </if>
        <if test="params.state!=null">
            and mn.State=#{params.state}
        </if>
        <if test="params.excludeDiscard!=null and params.excludeDiscard==1">
            and mn.State != 3
        </if>
        <if test="params.pId!=null">
            and INSTR(mn.p_id,#{params.pId})
        </if>
        <if test="params.secId!=null">
            and INSTR(mn.Sec_Id,#{params.secId})
        </if>
        <if test="params.srContact!=null">
            and mn.Sr_Contact like concat('%',#{params.srContact},'%')
        </if>
        <if test="params.srPhone!=null">
            and mn.Sr_Phone like concat('%',#{params.srPhone},'%')
        </if>
        <include refid="srAccessTimeFilter"/>
<!--        <if test="params.currentUid!=null">-->
<!--            and ((select count(*) from Sys_Task_Processin stp where stp.tp_entityid=mn.id and stp.tp_user=#{params.currentUid})>0-->
<!--            or mn.Sr_Create_Uid=#{params.currentUid}-->
<!--            )-->
<!--        </if>-->
    </sql>



    <!-- *********************************** dm *********************************** -->
    <sql id="srAccessTimeFilter" databaseId="dm">
        <if test="params.srAccessTimeStart!=null">
            and to_date(mn.Sr_Access_Time,'yyyy-MM-dd') >= to_date(#{params.srAccessTimeStart},'yyyy-MM-dd')
        </if>
        <if test="params.srAccessTimeEnd!=null">
            and to_date(mn.Sr_Access_Time,'yyyy-MM-dd') &lt;= to_date(#{params.srAccessTimeEnd},'yyyy-MM-dd')
        </if>
    </sql>


    <!-- *********************************** mysql *********************************** -->
    <sql id="srAccessTimeFilter" databaseId="mysql">
        <if test="params.srAccessTimeStart!=null">
            and date_format(mn.Sr_Access_Time,'%Y-%m-%d') >= date_format(#{params.srAccessTimeStart},'%Y-%m-%d')
        </if>
        <if test="params.srAccessTimeEnd!=null">
            and date_format(mn.Sr_Access_Time,'%Y-%m-%d') &lt;= date_format(#{params.srAccessTimeEnd},'%Y-%m-%d')
        </if>
    </sql>


    <!-- *********************************** gauss *********************************** -->
    <sql id="srAccessTimeFilter" databaseId="gauss">
        <if test="params.srAccessTimeStart!=null">
            and to_date(to_char(mn.Sr_Access_Time,'YYYY-MM-DD'),'YYYY-MM-DD') >=
            to_date(#{params.srAccessTimeStart},'YYYY-MM-DD')
        </if>
        <if test="params.srAccessTimeEnd!=null">
            and to_date(to_char(mn.Sr_Access_Time,'YYYY-MM-DD'),'YYYY-MM-DD') &lt;=
            to_date(#{params.srAccessTimeEnd},'YYYY-MM-DD')
        </if>
    </sql>


    <!-- *********************************** postgre *********************************** -->
    <sql id="srAccessTimeFilter" databaseId="postgre">
        <if test="params.srAccessTimeStart!=null">
            and to_date(to_char(mn.Sr_Access_Time,'yyyy-MM-dd'),'yyyy-MM-dd') >=
            to_date(#{params.srAccessTimeStart},'yyyy-MM-dd')
        </if>
        <if test="params.srAccessTimeEnd!=null">
            and to_date(to_char(mn.Sr_Access_Time,'yyyy-MM-dd'),'yyyy-MM-dd') &lt;=
            to_date(#{params.srAccessTimeEnd},'yyyy-MM-dd')
        </if>
    </sql>

</mapper>