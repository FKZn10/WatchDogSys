<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.secInfo.SecBidSecurityMapper">


    <resultMap type="com.jpmsoft.common.model.requestAndResponse.SecInfo.SecBidSecurityModel"
               id="SecBidSecurityModel">
        <id column="Sbs_Id" property="sbsId"/>
        <collection property="secProjects" ofType="com.jpmsoft.common.model.response.SecInfo.SecProjectResponse"
                    column="Sbs_Id" select="getSecInfoProject">
        </collection>
    </resultMap>


    <select id="getSecInfoProject" resultType="com.jpmsoft.common.model.response.SecInfo.SecProjectResponse">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        mn.*
        from   Sec_Project mn
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  Sec_Bid_Security sd on sd.Sec_Id=sec.Sec_Id
        where sd.Sbs_Id=#{sbsId}
    </select>


    <select id="getSecBidSecurityById" resultMap="SecBidSecurityModel">
        select
        sec.Sec_Name as secName,
        sec.Sec_Code as secCode,
        sec.Sec_Type as secType,
        f.file_relation_id as fileRelationId,
        mn.*
        from  Sec_Bid_Security mn
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  Sys_File f on f.FileID=mn.Sbs_Id
        where mn.Sbs_Id=#{sbsId}
    </select>


    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.secId!=null">
            and mn.Sec_Id = #{params.secId}
        </if>
        <if test="params.sbsState!=null">
            and mn.Sbs_State = #{params.sbsState}
        </if>
        <if test="params.sbsTitle!=null">
            and mn.Sbs_Title like concat('%',#{params.sbsTitle},'%')
        </if>
        <if test="params.sbsRemarks!=null">
            and mn.Sbs_Remarks like concat('%',#{params.sbsRemarks},'%')
        </if>
        <if test="params.secName!=null">
            and sec.Sec_Name like concat('%',#{params.secName},'%')
        </if>
        <if test="params.sbsCreateUname!=null">
            and mn.Sbs_Create_Uname like concat('%',#{params.sbsCreateUname},'%')
        </if>
        <!--区间筛选-->
        <if test="params.sbsEnterPriceStart!=null">
            and mn.Sbs_Number_Enterprises > #{params.sbsEnterPriceStart}
        </if>
        <if test="params.sbsEnterPriceEnd!=null">
            and mn.Sbs_Number_Enterprises &lt; #{params.sbsEnterPriceEnd}
        </if>
        <if test="params.sbsPayAmountStart!=null">
            and mn.Sbs_Cumulative_Payment_Amount > #{params.sbsPayAmountStart}
        </if>
        <if test="params.sbsPayAmountEnd!=null">
            and mn.Sbs_Cumulative_Payment_Amount &lt; #{params.sbsPayAmountEnd}
        </if>
        <if test="params.sbsCreateTimeStart!=null">
            and mn.Sbs_Create_Time > #{params.sbsCreateTimeStart}
        </if>
        <if test="params.sbsCreateTimeEnd!=null">
            and mn.Sbs_Create_Time &lt; #{params.sbsCreateTimeEnd}
        </if>
    </sql>

    <select id="getSecBidSecurityList" resultMap="SecBidSecurityModel">
        select
        sec.Sec_Name as secName,
        sec.Sec_Code as secCode,
        mn.*
        from  Sec_Bid_Security mn
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        where 1=1
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Sbs_Create_Time DESC
            </otherwise>
        </choose>
        limit #{params.start},#{params.size}
    </select>


    <select id="getSecBidSecurityListCount" resultType="java.lang.Integer">
        select
        count(1)
        from  Sec_Bid_Security mn
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        where 1=1
        <include refid="listFilter"/>
    </select>
</mapper>