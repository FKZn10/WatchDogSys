<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.secInfo.SecCalibrationSchemeMapper">


    <resultMap type="com.jpmsoft.common.model.requestAndResponse.SecInfo.SecCalibrationSchemeModel"
               id="SecCalibrationSchemeModel">
        <id column="Scs_Id" property="scsId"/>
        <collection property="secProjects" ofType="com.jpmsoft.common.model.response.SecInfo.SecProjectResponse"
                    column="Scs_Id" select="getSecInfoProject">
        </collection>
    </resultMap>


    <select id="getSecInfoProject" resultType="com.jpmsoft.common.model.response.SecInfo.SecProjectResponse">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        mn.*
        from   Sec_Project mn
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  Sec_Calibration_Scheme sd on sd.Sec_Id=sec.Sec_Id
        where sd.Scs_Id=#{scsId}
    </select>


    <select id="getSecCalibrationSchemeById" resultMap="SecCalibrationSchemeModel">
        select
        sec.Sec_Name as secName,
        sec.Sec_Code as secCode,
        sec.Sec_Type as secType,
        sec.Sec_Bidding_Type as secBiddingType,
        sd.D_Determin_Type as dDeterminType,
        sd.D_Scope as dScope,
        sec.Sec_Start_Time as secStartTime,
        sec.Sec_End_Time as secEndTime,
        f.file_relation_id as fileRelationId,
        mn.*
        from  Sec_Calibration_Scheme mn
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  Sec_Document sd on sd.Sec_Id=mn.Sec_Id
        left join  Sys_File f on f.FileID=mn.Scs_Id
        where mn.Scs_Id=#{scsId}
    </select>


    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.secId!=null">
            and mn.Sec_Id = #{params.secId}
        </if>
        <if test="params.scsState!=null">
            and mn.Scs_State = #{params.scsState}
        </if>
        <if test="params.secName!=null">
            and sec.Sec_Name like concat('%',#{params.secName},'%')
        </if>
        <if test="params.scsCreateUname!=null">
            and mn.Scs_Create_Uname like concat('%',#{params.scsCreateUname},'%')
        </if>
    </sql>

    <select id="getSecCalibrationSchemeList" resultMap="SecCalibrationSchemeModel">
        select
        sec.Sec_Name as secName,
        sec.Sec_Code as secCode,
        mn.*
        from  Sec_Calibration_Scheme mn
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        where 1=1
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Sbs_Create_Time desc
            </otherwise>
        </choose>
        limit #{params.start},#{params.size}
    </select>


    <select id="getSecCalibrationSchemeListCount" resultType="java.lang.Integer">
        select
        count(1)
        from  Sec_Calibration_Scheme mn
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        where 1=1
        <include refid="listFilter"/>
    </select>
</mapper>