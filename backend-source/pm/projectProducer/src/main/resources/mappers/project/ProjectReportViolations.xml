<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.project.ProjectReportViolationsMapper">
    <select id="getProjectReportViolationsById" resultType="com.jpmsoft.projectProducer.pojo.dto.project.ProjectReportViolationsDTO">
        SELECT mn.*, proj.P_Name AS pName
        FROM Project_Report_Violations mn
        LEFT JOIN Pre_Project proj ON proj.P_ID = mn.P_Id
        where mn.prv_id=#{id}
    </select>

    <select id="getProjectReportViolationsList"
            resultType="com.jpmsoft.projectProducer.pojo.dto.project.ProjectReportViolationsDTO">
        SELECT mn.*, proj.P_Name AS pName
        FROM Project_Report_Violations mn
        LEFT JOIN Pre_Project proj ON proj.P_ID = mn.P_Id
        <where>
            <if test="params.pId != null and params.pId != ''">
                AND mn.P_Id = #{params.pId}
            </if>
            <if test="params.pName != null and params.pName != ''">
                <choose>
                    <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                        AND likePname(#{params.pName},proj.P_Id)=true
                    </when>
                    <otherwise>
                        AND proj.P_Name LIKE CONCAT('%',#{params.pName},'%')
                    </otherwise>
                </choose>
            </if>
            <if test="params.prvCompany != null and params.prvCompany != ''">
                AND mn.prv_company LIKE CONCAT('%',#{params.prvCompany},'%')
            </if>
            <if test="params.prvPhone != null and params.prvPhone != ''">
                AND mn.prv_phone LIKE CONCAT('%',#{params.prvPhone},'%')
            </if>
        </where>
        ORDER BY mn.prv_create_time DESC
    </select>
</mapper>