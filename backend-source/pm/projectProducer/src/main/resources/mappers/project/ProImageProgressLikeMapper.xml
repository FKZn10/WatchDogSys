<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.project.ProImageProgressLikeMapper">

    <select id="getProImageProgressLikeByUid"
            resultType="com.jpmsoft.common.model.requestAndResponse.Project.ProImageProgressLikeModel">
        select *
        from Pro_Image_Progress_Like
        where create_uid = #{ params.createUid }
          and ip_id = #{ params.ipId }
    </select>
</mapper>