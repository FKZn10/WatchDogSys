<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.project.ProFundsUsageDetailsMapper">

    <select id="getProFundsUsageDetailsByCplIds" resultType="com.jpmsoft.common.model.request.project.ProFundsUsageDetailsDto">
        select * from Pro_Funds_Usage_Details where Cpl_Id in
        <foreach collection="cplIds" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
        order by Fud_Sort ASC
    </select>
</mapper>