<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.project.SingleProjectSolutionInfoMapper">
    <select id="selectSingleProjectSolutionInfoVo"
            resultType="com.jpmsoft.projectProducer.pojo.vo.project.SingleProjectSolutionInfoVo">
        select
        pro.P_Name as projectName,
        function_code as functionCode, sum,  url
        from single_project_solution_info mn
        left join pre_project pro on mn.project_id = pro.P_ID
        where mn.state =7
    </select>
</mapper>