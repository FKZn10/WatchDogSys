<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.project.ProAssignmentMapper">

    <select id="getProAssignmentById"
            resultType="com.jpmsoft.common.model.requestAndResponse.Project.ProAssignmentModel">
        select
        f.file_relation_id as fileRelationId,
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        c1.C_Name as paApprovalUnitName,
        c2.C_Name as paConcentrateUnitName,
        c3.C_Name as paUnitName,
        c1.C_Abbreviation as paApprovalAbbName,
        c2.C_Abbreviation as paConcentrateAbbName,
        c3.C_Abbreviation as paUnitAbbName,
        mn.*
        from  Pro_Assignment mn
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Sys_Company c1 on c1.C_Id=mn.Pa_Approval_Unit
        left join  Sys_Company c2 on c2.C_Id=mn.Pa_Concentrate_Unit_Id
        left join  Sys_Company c3 on c3.C_Id=mn.Pa_Unit_Id
        left join  Sys_File f on f.FileID=mn.Pa_Id
        where mn.Pa_Id=#{paId}
    </select>


    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id = #{params.pId}
        </if>
        <if test="params.paState!=null">
            and mn.Pa_State = #{params.paState}
        </if>
        <if test="params.paImplementationStatus!=null">
            and mn.Pa_Implementation_Status = #{params.paImplementationStatus}
        </if>
        <if test="params.paUnitId!=null">
            and mn.Pa_Unit_Id = #{params.paUnitId}
        </if>
        <if test="params.paApprovalUnit!=null">
            and mn.Pa_Approval_Unit = #{params.paApprovalUnit}
        </if>
        <if test="params.paConcentrateUnitId!=null">
            and mn.Pa_Concentrate_Unit_Id = #{params.paConcentrateUnitId}
        </if>
        <if test="params.paContent!=null">
            and mn.Pa_Content = #{params.paContent}
        </if>
        <if test="params.paStartYear!=null">
            and mn.Pa_Start_Year= #{params.paStartYear}
        </if>
        <if test="params.paEndYear!=null">
            and mn.Pa_End_Year = #{params.paEndYear}
        </if>
        <if test="params.paPayAudit!=null">
            and mn.Pa_Pay_Audit = #{params.paPayAudit}
        </if>
        <if test="params.paBidCompiling!=null">
            and mn.Pa_Bid_Compiling = #{params.paBidCompiling}
        </if>
        <if test="params.paAgentWay!=null">
            and mn.Pa_Agent_Way = #{params.paAgentWay}
        </if>
        <if test="params.paCreateUname!=null">
            and mn.Pa_Create_Uname like concat('%',#{params.paCreateUname},'%')
        </if>
        <if test="params.paApprovalNo!=null">
            and mn.Pa_Approval_No like concat('%',#{params.paApprovalNo},'%')
        </if>
        <if test="params.pName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likePname(#{params.pName},pro.P_Id)=true
                </when>
                <otherwise>
                    and pro.P_Name like concat('%',#{params.pName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.pCode!=null">
            and pro.P_Code like concat('%',#{params.pCode},'%')
        </if>
    </sql>


    <select id="getProAssignmentList"
            resultType="com.jpmsoft.common.model.requestAndResponse.Project.ProAssignmentModel">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        c1.C_Name as paApprovalUnitName,
        c2.C_Name as paConcentrateUnitName,
        c3.C_Name as paUnitName,
        c1.C_Abbreviation as paApprovalAbbName,
        c2.C_Abbreviation as paConcentrateAbbName,
        c3.C_Abbreviation as paUnitAbbName,
        mn.*
        from  Pro_Assignment mn
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Sys_Company c1 on c1.C_Id=mn.Pa_Approval_Unit
        left join  Sys_Company c2 on c2.C_Id=mn.Pa_Concentrate_Unit_Id
        left join  Sys_Company c3 on c3.C_Id=mn.Pa_Unit_Id
        ${params.authSql}
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by ISNULL(mn.${params.sortFiled}),mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ISNULL(${params.sortSideFiled}),${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Pa_Create_Time desc
            </otherwise>
        </choose>
    </select>

</mapper>