<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.project.BGVisaOrderMapper">

    <select id="getBGVisaOrderMoney" resultType="java.math.BigDecimal">
        select Sum(VO_Money)
        from BG_VisaOrder
        where
            State = 7
          and
            VO_GLConId = #{conId}
    </select>
</mapper>