<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.design.DesignProposalMapper">

    <select id="getDesignProposalById"
            resultType="com.jpmsoft.common.model.requestAndResponse.Design.DesignProposalModel">
        select
        pro.P_Name as pName,
        pro.P_Name_History as pNameHistory,
        proc.C_Name as pConstructionUnitName,
        proc.C_Abbreviation as pConsAbbName,
        prod.D_Name as pCompetentDepartmentName,
        c1.C_Name as dpFeasibilityUnitName,
        c1.C_Name_History as dpFeasibilityUnitNameHistory,
        c2.C_Name as dpEstimationUnitName,
        c2.C_Name_History as dpEstimationUnitNameHistory,
        c1.C_Abbreviation as dpFeasibilityUnitAbbName,
        c2.C_Abbreviation as dpEstimationUnitAbbName,
        con.Con_Name as conName,
        con.Con_Code as conCode,
        f.file_relation_id as fileRelationId,
        mn.*
        from  Design_Proposal mn
        left join Con_Contract con on con.Con_Id=mn.Con_Id
        left join  Pre_Project pro on pro.P_Id=mn.P_Id
        left join SYS_Company proc on proc.C_Id=pro.P_Construction_Unit
        left join SYS_Department prod on prod.D_Id=pro.P_Competent_Department
        left join  Sys_Company c1 on c1.C_Id=mn.Dp_Feasibility_Unit_Id
        left join  Sys_Company c2 on c2.C_Id=mn.Dp_Estimation_Unit_Id
        left join  Sys_File f on f.FileID=mn.Dp_Id
        where mn.Dp_Id=#{dpId}
    </select>


    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id = #{params.pId}
        </if>
        <if test="params.dfState!=null">
            and mn.Dp_State = #{params.dfState}
        </if>
        <if test="params.dpFeasibilityUnitTel!=null">
            and mn.Dp_Feasibility_Unit_Tel like concat('%',#{params.dpFeasibilityUnitTel},'%')
        </if>
        <if test="params.dpCode!=null">
            and mn.Dp_Code like concat('%',#{params.dpCode},'%')
        </if>
        <if test="params.dpName!=null">
            and mn.Dp_Name like concat('%',#{params.dpName},'%')
        </if>
        <if test="params.dfCreateUname!=null">
            and mn.Dp_Create_Uname like concat('%',#{params.dpCreateUname},'%')
        </if>
        <if test="params.dfName!=null">
            and mn.Dp_Name like concat('%',#{params.dpName},'%')
        </if>
        <if test="params.conName!=null">
            and con.Con_Name like concat('%',#{params.conName},'%')
        </if>
        <if test="params.conCode!=null">
            and con.Con_Code like concat('%',#{params.conCode},'%')
        </if>
        <if test="params.pNameHistory!=null">
            and pro.P_Name_History like concat('%',#{params.pNameHistory},'%')
        </if>
        <choose>
            <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                <if test="params.dpFeasibilityUnitName!=null">
                    and likeCname(#{params.dpFeasibilityUnitName},c1.C_Id)=true
                </if>
                <if test="params.dpEstimationUnitName!=null">
                    and likeCname(#{params.dpEstimationUnitName},c2.C_Id)=true
                </if>
                <if test="params.pName!=null">
                    and likePname(#{params.pName},pro.P_Id)=true
                </if>
            </when>
            <otherwise>
                <if test="params.dpFeasibilityUnitName!=null">
                    and c1.C_Name like concat('%',#{params.dpFeasibilityUnitName},'%')
                </if>
                <if test="params.dpEstimationUnitName!=null">
                    and c2.C_Name like concat('%',#{params.dpEstimationUnitName},'%')
                </if>
                <if test="params.pName!=null">
                    and pro.P_Name like concat('%',#{params.pName},'%')
                </if>
            </otherwise>
        </choose>
    </sql>

    <select id="getDesignProposalList"
            resultType="com.jpmsoft.common.model.requestAndResponse.Design.DesignProposalModel">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        c1.C_Name as dpFeasibilityUnitName,
        c1.C_Name_History as dpFeasibilityUnitNameHistory,
        c2.C_Name as dpEstimationUnitName,
        c2.C_Name_History as dpEstimationUnitNameHistory,
        c1.C_Abbreviation as dpFeasibilityUnitAbbName,
        c2.C_Abbreviation as dpEstimationUnitAbbName,
        f.file_relation_id as fileRelationId,
        con.Con_Name as conName,
        con.Con_Code as conCode,
        mn.*
        from  Design_Proposal mn
        left join Con_Contract con on con.Con_Id=mn.Con_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Sys_Company c1 on c1.C_Id=mn.Dp_Feasibility_Unit_Id
        left join  Sys_Company c2 on c2.C_Id=mn.Dp_Estimation_Unit_Id
        left join  Sys_File f on f.FileID=mn.Dp_Id
        <if test="params.authSql!=null">
            ${params.authSql}
        </if>
        <if test="params.authSql==null">
            where 1=1
        </if>
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Dp_Create_Time desc
            </otherwise>
        </choose>
    </select>

</mapper>