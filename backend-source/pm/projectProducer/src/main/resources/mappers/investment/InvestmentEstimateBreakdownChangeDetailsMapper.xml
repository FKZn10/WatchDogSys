<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.investment.InvestmentEstimateBreakdownChangeDetailsMapper">
    <delete id="deleteByIsbChangeId">
        delete from investment_estimate_breakdown_change_details where isb_change_id = #{primaryId}
    </delete>
    <select id="getDataByIsbId"
            resultType="com.jpmsoft.common.model.requestAndResponse.InvestmentControl.InvestmentEstimateBreakdownChangeDetailsModel">
        select * from  investment_estimate_breakdown_change_details where isb_change_id = #{isbId}
    </select>


</mapper>