<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.investment.InvInfrastructureMonthMapper">

    <resultMap type="com.jpmsoft.projectProducer.pojo.vo.investment.InvInfrastructureMonthVo"
               id="getInvInfrastructureMonth">
        <id column="id" property="id"/>
        <collection property="invInfrastructureMonthDtls"
                    ofType="com.jpmsoft.projectProducer.pojo.vo.investment.InvInfrastructureMonthDtlVo"
                    column="id" select="getInvInfrastructureMonthDtl">
        </collection>
    </resultMap>

    <select id="getInvInfrastructureMonthDtl"
            resultType="com.jpmsoft.projectProducer.pojo.vo.investment.InvInfrastructureMonthDtlVo">
        select pro.P_Name as pName,
               pro.P_Code as pCode,
               mn.*
        from Inv_Infrastructure_Month_Dtl mn
                 left join Pre_Project pro on pro.P_Id = mn.P_Id
        where mn.Im_Id = #{id}
        order by mn.Imd_Sort asc
    </select>

    <select id="getInvInfrastructureMonthById" resultMap="getInvInfrastructureMonth">
        select f.File_Relation_Id as fileRelationId,
               mn.*
        from Inv_Infrastructure_Month mn
                 left join SYS_File f on f.FileId = mn.id
        where mn.id = #{id}
    </select>
</mapper>