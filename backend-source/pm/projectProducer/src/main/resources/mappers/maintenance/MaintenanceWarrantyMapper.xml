<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.projectProducer.mapper.maintenance.MaintenanceWarrantyMapper">

    <select id="getMaintenanceWarrantyById" resultType="com.jpmsoft.common.model.response.Maintenance.MaintenanceWarrantyResponse">
        select
        con.Con_Name as conName,
        con.Con_Code as conCode,
        pro.P_Name as pName,
        proc.C_Name as pConstructionUnitName,
        proc.C_Abbreviation as pConsAbbName,
        prod.D_Name as pCompetentDepartmentName,
        c1.C_Name as mwCName,
        c1.C_Abbreviation as mwAbbName,
        sec.Sec_Name as secName,
        f.file_relation_id as fileRelationId,
        mn.*
        from  Maintenance_Warranty mn
        left join  Con_Contract con on con.Con_Id=mn.Con_Id
        left join  Pre_Project pro on pro.P_Id=mn.P_Id
        left join SYS_Company proc on proc.C_Id=pro.P_Construction_Unit
        left join SYS_Department prod on prod.D_Id=pro.P_Competent_Department
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  SYS_Company c1 on c1.C_Id=mn.Mw_C_Id
        left join  Sys_File f on f.FileID=mn.Mw_Id
        where mn.Mw_Id=#{mwId}
    </select>


    <sql id="listFilter">
        <if test="params.teId!=null">
            and mn.Te_Id = #{params.teId}
        </if>
        <if test="params.pId!=null">
            and mn.P_Id=#{params.pId}
        </if>
        <if test="params.secId!=null">
            and mn.Sec_Id=#{params.secId}
        </if>
        <if test="params.mwCId!=null">
            and mn.Mw_C_Id=#{params.mwCId}
        </if>
        <if test="params.mwState!=null">
            and mn.Mw_State=#{params.mwState}
        </if>
        <if test="params.pName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likePname(#{params.pName},pro.P_Id)=true
                </when>
                <otherwise>
                    and pro.P_Name like concat('%',#{params.pName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.conName!=null">
            and con.Con_Name like concat('%',#{params.conName},'%')
        </if>
        <if test="params.mwCName!=null">
            <choose>
                <when test="@com.jpmsoft.projectProducer.config.XmlConfig@hsEnable()">
                    and likeCname(#{params.mwCName},c1.C_Id)=true
                </when>
                <otherwise>
                    and c1.C_Name like concat('%',#{params.mwCName},'%')
                </otherwise>
            </choose>
        </if>
        <if test="params.mwRemark!=null">
            and mn.Mw_Remark=#{params.mwRemark}
        </if>
        <if test="params.mwCreateUname!=null">
            and mn.Mw_Create_Uname=#{params.mwCreateUname}
        </if>
        <!--区间筛选-->
        <if test="params.mwCreateTimeStart!=null">
            and mn.Mw_Create_Time > #{params.mwCreateTimeStart}
        </if>
        <if test="params.mwCreateTimeEnd!=null">
            and mn.Mw_Create_Time &lt; #{params.mwCreateTimeEnd}
        </if>
    </sql>

    <select id="getMaintenanceWarrantyList" resultType="com.jpmsoft.common.model.response.Maintenance.MaintenanceWarrantyResponse">
        select
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectFields"/>
        con.Con_Name as conName,
        con.Con_Code as conCode,
        c1.C_Name_History as mwCNameHistory,
        c1.C_Name as mwCName,
        c1.C_Abbreviation as mwAbbName,
        sec.Sec_Name as secName,
        mn.*
        from  Maintenance_Warranty mn
        left join  Con_Contract con on con.Con_Id=mn.Con_Id
        <include refid="com.jpmsoft.projectProducer.mapper.project.PreProjectMapper.commonProjectSelectLinks"/>
        left join  Sec_Info sec on sec.Sec_Id=mn.Sec_Id
        left join  SYS_Company c1 on c1.C_Id=mn.Mw_C_Id
        <if test="params.authSql!=null">
            ${params.authSql}
        </if>
        <if test="params.authSql==null">
            where 1=1
        </if>
        <include refid="listFilter"/>
        <choose>
            <when test="params.sortType!=null and params.sortFiled!=null">
                order by mn.${params.sortFiled} ${params.sortType}
            </when>
            <when test="params.sortType!=null and params.sortSideFiled!=null">
                order by ${params.sortSideFiled} ${params.sortType}
            </when>
            <otherwise>
                order by mn.Mw_Create_Time desc
            </otherwise>
        </choose>
    </select>
</mapper>