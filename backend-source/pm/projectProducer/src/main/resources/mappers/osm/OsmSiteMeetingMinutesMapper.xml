<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jpmsoft.projectProducer.mapper.osm.OsmSiteMeetingMinutesMapper">


    <select id="getSiteMeetingMinutesList"
            resultType="com.jpmsoft.common.model.requestAndResponse.osm.OsmSiteMeetingMinutesDto">
        select * from osm_site_meeting_minutes
        <where>
            <if test="params.title != null and params.title!='' ">
                and title like concat('%',#{params.title},'%')
            </if>
            <if test="params.code != null and params.code!='' ">
                and code like concat('%',#{params.code},'%')
            </if>
            <if test="params.handlerUserName != null and params.handlerUserName!='' ">
                and handler_user_name like concat('%',#{params.handlerUserName},'%')
            </if>
            <if test="params.state != null">
                and state = #{params.state}
            </if>
            <if test="params.createUname != null and params.createUname!='' ">
                and create_uname like concat('%',#{params.createUname},'%')
            </if>
        </where>
    </select>

</mapper>

