<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.fileUpload.mapper.OutlineDatasourceMapper">
    <resultMap id="OutlineDatasource" type="com.jpmsoft.fileUpload.pojo.dto.easyexcel.OutlineDatasourceDTO">
        <id column="id" property="id"/>
        <result column="od_name" property="odName"/>
        <result column="od_type" property="odType"/>
        <result column="od_source" property="odSource"/>
        <result column="od_status" property="odStatus"/>
        <result column="od_remark" property="odRemark"/>
        <result column="od_address" property="odAddress"/>
        <result column="od_method" property="odMethod"/>
        <result column="od_body" property="odBody"/>
        <result column="od_alias" property="odAlias"/>
        <result column="od_data_type" property="odDataType"/>
        <result column="create_uid" property="createUid"/>
        <result column="create_uname" property="createUname"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <collection property="tCodes" ofType="java.lang.String">
            <result column="tCodes"/>
        </collection>
    </resultMap>
    <select id="getOutlineDatasourceByIds" resultMap="OutlineDatasource" databaseId="mysql">
        select
        mn.*,
        (select GROUP_CONCAT(T_Code separator ',')
        from Outline_Datasource_Temp
        where od_id = mn.id) as tCodes
        from outline_datasource mn
        where id in
        <foreach item="item" index="index" collection="ids" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
    <select id="getOutlineDatasourceByIds" resultMap="OutlineDatasource" databaseId="dm">
        select
        mn.*,
        (select LISTAGG(T_Code, ',') within group (order by T_Code)
        from Outline_Datasource_Temp
        where od_id = mn.id) as tCodes
        from outline_datasource mn
        where id in
        <foreach item="item" index="index" collection="ids" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
</mapper>