<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jpmsoft.custom.mapper.SysFileMapper">

    <insert id="insertBath">
        <foreach collection="sqls" open="" close="" separator=";" item="sql">
            ${sql}
        </foreach>
    </insert>

    <delete id="deleteBath">
        <foreach collection="sqls" open="" close="" separator=";" item="sql">
            ${sql}
        </foreach>
    </delete>

    <select id="querySql" resultType="Map">
        ${sql}
    </select>

    <select id="queryList" resultType="Map">
        ${sql}
    </select>

    <select id="queryPage" resultType="Map">
        ${sql}
        <if test="params.sortType!='' and (params.sortFiled!='' or params.sortSideFiled!='')">
            <choose>
                <when test="params.sortType!=null and params.sortFiled!=null">
                    order by mn.${params.sortFiled} ${params.sortType}
                </when>
                <when test="params.sortType!=null and params.sortSideFiled!=null">
                    order by ${params.sortSideFiled} ${params.sortType}
                </when>
            </choose>
        </if>
        limit ${start},${size}
    </select>

    <select id="sumQuery" resultType="Map">
        ${sql}
    </select>


    <select id="queryPageSize" resultType="Integer">
        select count(*)
        from (${sql}) hz291c
    </select>
</mapper>