    <groupId>com.jpmsoft.jpbpm</groupId>
    <artifactId>jp-bpm</artifactId>
    <version>1.0.0.0.0</version>
    <name>jp-bpm</name>
    <description>Demo project for Spring Cloud</description>
    <packaging>${project.packaging}</packaging>

    <profiles>
        <!-- 默认打包配置 war包 -->
        <profile>
            <id>defaultWar</id>
            <activation>
                <!-- 默认环境 -->
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <project.packaging>war</project.packaging>
                <activatedEnv>dev</activatedEnv>
                <swgEnable>true</swgEnable>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-starter-tomcat</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-war-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>core</id>
            <properties>
                <project.packaging>jar</project.packaging>
                <activatedEnv>dm</activatedEnv>
                <swgEnable>false</swgEnable>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <includeSystemScope>true</includeSystemScope>
                            <encoding>UTF-8</encoding>
                            <resources>
                                <resource>
                                    <directory>src/main/resources</directory>
                                    <includes>
                                        <include>application.yml</include>
                                        <include>application-china-resource.yml</include>
                                        <include>application-gauss.yml</include>
                                        <include>application-dm.yml</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- 默认打包配置 jar包 -->
        <profile>
            <id>defaultJar</id>
            <properties>
                <project.packaging>jar</project.packaging>
